# WebShield Configuration
APP_ENV=development
DATABASE_URL=sqlite:///./webshield.db

# Crawler limits (important for safety + performance)
MAX_PAGES=50
MAX_DEPTH=3
REQUEST_DELAY_SECONDS=0.5
REQUEST_TIMEOUT_SECONDS=10
USER_AGENT=WebShield-DAST-Scanner/1.0

# Consent gate — scans are blocked unless this is acknowledged per-scan via API
REQUIRE_CONSENT=true
